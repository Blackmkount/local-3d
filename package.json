{
  "name": "blackforge-local-3d",
  "version": "0.0.0",
  "private": true,
  "description": "Recorrido 3D interactivo del local BlackForge: muebles, materiales, costos y armado paso a paso",
  "homepage": "https://blackmkount.github.io/local-3d/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blackmkount/local-3d.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "http-server -p 8000 -c-1 .",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test",
    "version": "node tools/bump-version.mjs",
    "vendor": "node tools/vendor.mjs",
    "build:single": "python3 tools/build-artifact.py",
    "og": "node tools/capture.mjs",
    "icons": "node tools/icons.mjs",
    "video:75": "node tools/video-pantalla/render.js http://localhost:8000/tools/video-pantalla/index.html",
    "video:exterior": "node tools/video-exterior/render.js http://localhost:8000/tools/video-exterior/index.html"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.0.18",
    "@playwright/test": "1.56.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "http-server": "14.1.1",
    "three": "0.160.0"
  }
}
