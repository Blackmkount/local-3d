# Formato común para todos los editores (https://editorconfig.org).
# Los archivos ya cumplen estas reglas: no hace falta reformatear nada.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# en Markdown, dos espacios al final de una línea son un salto de línea
trim_trailing_whitespace = false
